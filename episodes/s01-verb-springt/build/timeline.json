 "sentences": [
  {
   "text": "Weil ich müde bin.",
   "start": 0.135,
   "end": 1.385,
   "words": [
    0,
    3
   ]
  },
  {
   "text": "Nicht: „weil ich bin müde“.",
   "start": 1.76,
   "end": 4.37,
   "words": [
    4,
    8
   ]
  },
  {
   "text": "Das ist der Fehler Nummer eins auf B1.",
   "start": 4.84,
   "end": 7.095,
   "words": [
    9,
    16
   ]
  },
  {
   "text": "Die Regel in zehn Sekunden.",
   "start": 7.675,
   "end": 9.14,
   "words": [
    17,
    21
   ]
  },
  {
   "text": "Es gibt drei Gruppen.",
   "start": 9.53,
   "end": 10.51,
   "words": [
    22,
    25
   ]
  },
  {
   "text": "Eins: und, aber, oder, denn, sondern.",
   "start": 10.915,
   "end": 14.125,
   "words": [
    26,
    31
   ]
  },
  {
   "text": "Sie zählen nicht – das Verb bleibt auf Platz zwei: … denn ich bin müde.",
   "start": 14.555,
   "end": 18.53,
   "words": [
    32,
    44
   ]
  },
  {
   "text": "Zwei: deshalb, trotzdem, dann.",
   "start": 19.035,
   "end": 21.65,
   "words": [
    45,
    48
   ]
  },
  {
   "text": "Sie stehen selbst auf Platz eins – das Verb kommt sofort danach: … deshalb trinke ich Kaffee.",
   "start": 22.075,
   "end": 27.145,
   "words": [
    49,
    63
   ]
  },
  {
   "text": "Drei: weil, dass, obwohl, wenn.",
   "start": 27.61,
   "end": 30.465,
   "words": [
    64,
    68
   ]
  },
  {
   "text": "Hier springt das Verb ans Ende: … weil ich müde bin.",
   "start": 30.86,
   "end": 33.88,
   "words": [
    69,
    78
   ]
  },
  {
   "text": "Profi-Level: Steht der Nebensatz vorne, treffen sich die Verben: Obwohl ich Kaffee trinke, bin ich müde.",
   "start": 34.29,
   "end": 40.325,
   "words": [
    79,
    94
   ]
  },
  {
   "text": "Und warum trinke ich so viel Kaffee?",
   "start": 40.64,
   "end": 43.06,
   "words": [
    95,
    101
   ]
  }
 ],
