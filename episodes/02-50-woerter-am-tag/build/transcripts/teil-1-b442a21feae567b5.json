, {"w": "Kautionen.", "s": 268.43, "e": 269.09, "p": 0.997}, {"w": "Ja,", "s": 269.88, "e": 270.48, "p": 0.992}, {"w": "wirklich", "s": 270.68, "e": 271.1, "p": 0.999}, {"w": "laut.", "s": 271.1, "e": 271.46, "p": 0.999}, {"w": "Deine", "s": 271.78, "e": 272.24, "p": 1.0}, {"w": "Mitbewohnerin", "s": 272.24, "e": 272.94, "p": 1.0}, {"w": "wird", "s": 272.94, "e": 273.18, "p": 1.0}, {"w": "es", "s": 273.18, "e": 273.32, "p": 1.0}, {"w": "überleben.", "s": 273.32, "e": 273.8, "p": 1.0}], "segments": [{"s": 0.0, "e": 10.67, "text": "Wortnummer achtundvierzig, neunundvierzig, fünfzig, geschafft! Und am nächsten Morgen sind noch drei da. Kennst du das? Ich auch."}, {"s": 11.13, "e": 16.77, "text": "Heute lernst du zehn echte Wörter und am Ende teste ich dich. Wetten, du kannst sie dann noch?"}, {"s": 17.15, "e": 23.1, "text": "Hi, ich bin Melo und ja, mein Kopf ist immer noch eine Wassermelone. Hier gibt's Deutsch mit Kern."}, {"s": 23.64, "e": 30.62, "text": "Heute geht's um eine Frage, die ich ständig bekomme. Kann man fünfzig Wörter am Tag lernen? Die ehrliche Antwort, ja."}, {"s": 30.8, "e": 33.0, "text": "Aber nicht so, wie die meisten es machen."}, {"s": 33.34, "e": 35.64, "text": "Ich zeige dir das 5x10-System."}, {"s": 35.93, "e": 38.13, "text": "Kein Trick, keine App, kein Wunder."}, {"s": 38.33, "e": 39.23, "text": "Es ist Arbeit."}, {"s": 39.51, "e": 42.39, "text": "Ungefähr 75 bis 90 Minuten am Tag."}, {"s": 42.61, "e": 43.97, "text": "Aber es funktioniert."}, {"s": 44.19, "e": 45.73, "text": "Und ich zeige dir genau warum."}, {"s": 46.06, "e": 48.12, "text": "Und wir machen es nicht nur theoretisch."}, {"s": 48.26, "e": 50.36, "text": "Wir lernen zusammen ein echtes Paket."}, {"s": 50.6, "e": 51.4, "text": "10 Wörter."}, {"s": 51.78, "e": 53.34, "text": "Der Test kommt bestimmt."}, {"s": 53.92, "e": 55.0, "text": "Fehler Nummer 1."}, {"s": 55.46, "e": 56.4, "text": "Zufällige Listen."}, {"s": 56.8, "e": 59.94, "text": "Apfel, Ehrlichkeit, Schraubenzieher, Wolke."}, {"s": 59.94, "e": 63.43, "text": "Für dein Gehirn ist das wie ein Haufen Briefe ohne Adresse."}, {"s": 63.79, "e": 65.31, "text": "Die Post weiß nicht, wohin damit."}, {"s": 65.85, "e": 69.75, "text": "Deshalb, jedes Paket mit zehn Wörtern kommt aus einer echten Quelle."}, {"s": 69.97, "e": 73.45, "text": "Aus einem Podcast, aus einem Artikel, aus einer Wohnungsanzeige."}, {"s": 73.61, "e": 77.05, "text": "Und zu jedem Wort schreibst du den Satz, in dem du es gefunden hast."}, {"s": 77.35, "e": 78.83, "text": "Der Satz ist die Adresse."}, {"s": 79.21, "e": 81.79, "text": "Dein Kopf weiß dann, dieses Wort wohnt hier."}, {"s": 82.24, "e": 85.24, "text": "Und warum fünf Pakete statt 50 Wörter auf einmal?"}, {"s": 85.64, "e": 87.9, "text": "Weil 50 auf einmal nicht hängen bleiben."}, {"s": 87.9, "e": 93.26, "text": "Nach dem zwanzigsten Wort ist der Kopf voll. Sogar meiner. Und der ist ziemlich groß."}, {"s": 93.54, "e": 98.62, "text": "Also verteilst du sie über den Tag. Ein Paket am Morgen, zum Beispiel aus einem Podcast beim"}, {"s": 98.62, "e": 104.1, "text": "Frühstück. Eins am Mittag aus einem Artikel. Eins am Nachmittag aus einer Anzeige. Eins am"}, {"s": 104.1, "e": 109.72, "text": "Abend aus deiner Serie. Und das letzte vor dem Schlafen aus einem Buch. Und unser Paket heute"}, {"s": 109.72, "e": 114.94, "text": "kommt von hier, aus einer Wohnungsanzeige. Ich suche gerade eine Wohnung. Und ich habe diese"}, {"s": 114.94, "e": 122.6, "text": "Anzeige gefunden. Nachmieter gesucht. Zwei Zimmer, möbliert, provisionsfrei. Kaltmiete 650 Euro plus"}, {"s": 122.6, "e": 128.9, "text": "180 Euro Nebenkosten. Kaution, drei Kaltmieten. Ich habe gekündigt, meine Kündigungsfrist läuft"}, {"s": 128.9, "e": 134.9, "text": "bis Ende März. Besichtigung am Samstag um 11. Die Vermieterin ist auch da. Zehn Wörter, eine"}, {"s": 134.9, "e": 140.78, "text": "Adresse. Gehen wir sie durch. Der Nachmieter. Der Mieter wohnt jetzt in der Wohnung. Der Nachmieter"}, {"s": 140.78, "e": 147.84, "text": "zieht danach ein, also du, hoffentlich. Möbliert heißt mit Möbeln. Bett, Tisch, Schrank,"}, {"s": 148.08, "e": 154.8, "text": "alles schon da. Provisionsfrei heißt, du zahlst keine Provision an einen Makler. Der Makler"}, {"s": 154.8, "e": 160.57, "text": "bekommt sein Geld also nicht von dir. Die Kaltmiete ist die Miete ohne Heizung, ohne"}, {"s": 160.57, "e": 167.31, "text": "Wasser, ohne Müll. Nur die Wohnung. Kalt eben. Ich als Melone mag es ja kalt. Heizung,"}, {"s": 167.31, "e": 174.06, "text": "Wasser, Müll. Das alles sind die Nebenkosten. Achtung, das Wort gibt es nur im Plural. Und"}, {"s": 174.06, "e": 180.3, "text": "Kaltmiete plus Nebenkosten ergibt die Warmmiete. Das ist der Betrag, den du jeden Monat wirklich"}, {"s": 180.3, "e": 187.84, "text": "zahlst. Kurze Kernfrage. Kaltmiete 650, Nebenkosten 180. Wie hoch ist die Warmmiete?"}, {"s": 188.14, "e": 197.16, "text": "5 Sekunden. 830 Euro. Wenn jemand sagt 830 warm, meint er genau das. Die Kaution. Geld,"}, {"s": 197.16, "e": 202.65, "text": "das du am Anfang zahlst, als Sicherheit für den Vermieter. Wenn du ausziehst und alles okay ist,"}, {"s": 202.93, "e": 208.95, "text": "bekommst du es zurück. In Deutschland darf sie höchstens drei Kaltmieten betragen. In unserer"}, {"s": 208.95, "e": 217.06, "text": "Anzeige also fast 2000 Euro. Gekündigt kommt von kündigen, einen Vertrag beenden, die Wohnung"}, {"s": 217.06, "e": 222.91, "text": "kündigen, den Handyvertrag kündigen, den Job kündigen. Ich habe gekündigt, ohne Objekt,"}, {"s": 222.91, "e": 228.37, "text": "heißt meistens, ich habe meinen Job gekündigt. Also besser nicht vor der Chefin sagen, wenn du"}, {"s": 228.37, "e": 234.15, "text": "nur dein Fitnessstudio meinst. Die Kündigungsfrist ist die Zeit zwischen deiner Kündigung und dem Ende"}, {"s": 234.15, "e": 240.35, "text": "des Vertrags. Für Mieter in Deutschland meistens drei Monate. Die Besichtigung. Du schaust dir die"}, {"s": 240.35, "e": 246.99, "text": "Wohnung an, bevor du sie mietest. Das Verb dazu, besichtigen. Und die Vermieterin oder der Vermieter"}, {"s": 246.99, "e": 252.91, "text": "ist die Person, der du jeden Monat die Miete zahlst. Der Mieter zahlt, der Vermieter kassiert."}, {"s": 253.17, "e": 255.51, "text": "Zehn Wörter gelesen. Und jetzt?"}, {"s": 255.85, "e": 260.01, "text": "Lesen ist nicht lernen. Jedes Wort bekommt vier Spuren im Kopf."}, {"s": 260.23, "e": 265.75, "text": "Ich zeige es dir mit Kaution. Spur 1. Laut mit Artikel und Plural."}, {"s": 266.01, "e": 269.09, "text": "Sag es mit mir. Die Kaution, die Kautionen."}, {"s": 269.88, "e": 273.8, "text": "Ja, wirklich laut. Deine Mitbewohnerin wird es überleben."}]}
