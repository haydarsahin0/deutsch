, {"w": "jetzt", "s": 273.81, "e": 274.11, "p": 1.0}, {"w": "der", "s": 274.11, "e": 274.49, "p": 0.975}, {"w": "Test,", "s": 274.49, "e": 274.87, "p": 0.999}, {"w": "den", "s": 274.99, "e": 275.05, "p": 1.0}, {"w": "ich", "s": 275.05, "e": 275.19, "p": 1.0}, {"w": "dir", "s": 275.19, "e": 275.27, "p": 1.0}, {"w": "am", "s": 275.27, "e": 275.41, "p": 1.0}, {"w": "Anfang", "s": 275.41, "e": 275.71, "p": 1.0}, {"w": "versprochen", "s": 275.71, "e": 276.17, "p": 1.0}, {"w": "habe.", "s": 276.17, "e": 276.47, "p": 1.0}, {"w": "Ich", "s": 276.69, "e": 277.01, "p": 1.0}, {"w": "sage", "s": 277.01, "e": 277.27, "p": 1.0}, {"w": "die", "s": 277.27, "e": 277.41, "p": 1.0}, {"w": "Bedeutung,", "s": 277.41, "e": 277.97, "p": 1.0}, {"w": "du", "s": 278.13, "e": 278.33, "p": 0.998}, {"w": "sagst", "s": 278.33, "e": 278.67, "p": 1.0}, {"w": "das", "s": 278.67, "e": 278.85, "p": 1.0}, {"w": "Wort.", "s": 278.85, "e": 279.15, "p": 1.0}, {"w": "Laut.", "s": 279.45, "e": 279.79, "p": 0.999}, {"w": "Mit", "s": 280.09, "e": 280.35, "p": 1.0}, {"w": "Artikel.", "s": 280.35, "e": 280.83, "p": 1.0}, {"w": "Bereit?", "s": 281.09, "e": 281.59, "p": 1.0}], "segments": [{"s": 0.02, "e": 7.79, "text": "Spur zwei, mit der Hand schreiben, nicht tippen. Die Hand ist langsamer als die Tastatur und genau das hilft dem Kopf."}, {"s": 8.48, "e": 19.04, "text": "Spur drei, ein eigener Satz über dein Leben. Nicht aus dem Buch, sondern von dir. Was du selbst formulierst, bleibt viel besser hängen. Das nennt man den Generierungseffekt."}, {"s": 19.55, "e": 26.58, "text": "Mein Satz, für meine erste Wohnung habe ich zwei Kaltmieten-Kaution bezahlt. Danach gab es drei Monate Nudeln."}, {"s": 26.85, "e": 31.05, "text": "Spur 4. Nur für schwierige Wörter. Ein absurdes Bild."}, {"s": 31.86, "e": 38.14, "text": "Kaution. Kau. Stell dir vor, deine Vermieterin kaut auf deinem Geld herum. Jahrelang."}, {"s": 38.46, "e": 43.6, "text": "Mit dem Ursprung des Wortes hat das nichts zu tun. Aber dein Kopf vergisst das Bild nie wieder."}, {"s": 44.19, "e": 48.34, "text": "Noch eins. Die Kündigungsfrist. Frist klingt wie Frist."}, {"s": 48.84, "e": 52.68, "text": "Stell dir ein kleines Monster vor, das drei Monate von deinem Kalender frisst."}, {"s": 52.68, "e": 55.98, "text": "Und jetzt die anderen, mit Artikel und Plural."}, {"s": 56.59, "e": 71.67, "text": "Sprich mit die Kaltmiete, die Kaltmieten, die Nebenkosten, nur Plural, der Vermieter, die Vermieter, die Besichtigung, die Besichtigungen, der Nachmieter, die Kündigungsfrist, die Kündigungsfristen."}, {"s": 72.17, "e": 75.81, "text": "Möbliert und provisionsfrei sind Adjektive, also kein Artikel."}, {"s": 76.06, "e": 79.84, "text": "Und das Verb kündigen, kündigte, hat gekündigt."}, {"s": 79.98, "e": 81.3, "text": "Kurz zwischendurch."}, {"s": 81.52, "e": 83.92, "text": "Wenn du merkst, dass das hier mehr ist als ein Trick,"}, {"s": 84.34, "e": 87.06, "text": "abonnier den Kanal, dann verpasst du das nächste Paket nicht."}, {"s": 87.44, "e": 89.08, "text": "Jetzt kommt der wichtigste Teil."}, {"s": 89.32, "e": 90.82, "text": "Die meisten wiederholen so."}, {"s": 91.02, "e": 94.4, "text": "Sie lesen Kaution und denken, ah ja, kenn ich."}, {"s": 94.76, "e": 96.06, "text": "Das ist Wiedererkennen."}, {"s": 96.24, "e": 98.5, "text": "Das fühlt sich gut an, bringt aber wenig."}, {"s": 99.04, "e": 102.08, "text": "Lernen passiert, wenn du das Wort selbst aus dem Kopf holst."}, {"s": 102.24, "e": 103.8, "text": "Also immer andersherum."}, {"s": 104.02, "e": 106.04, "text": "Von der Bedeutung zum deutschen Wort."}, {"s": 106.42, "e": 108.46, "text": "Geld als Sicherheit für den Vermieter."}, {"s": 108.68, "e": 109.48, "text": "Wie heißt das?"}, {"s": 109.48, "e": 116.58, "text": "Die Abrufleiter hat drei Stufen. Am selben Tag. Nach 10 Minuten, nach einer Stunde und vor dem Schlafen."}, {"s": 116.84, "e": 125.95, "text": "Jedes Mal das ganze Paket. Jedes Mal Bedeutung, Pause, deutsches Wort. Laut. Ja, auch im Büro. Leise reicht."}, {"s": 126.49, "e": 131.47, "text": "Okay, 10 Minuten sind noch nicht ganz vorbei. Aber wir machen trotzdem die erste Stufe."}, {"s": 131.77, "e": 136.11, "text": "Sag die Antwort laut, mit Artikel, bevor du auf die Optionen schaust."}, {"s": 136.11, "e": 139.16, "text": "Die Person, die nach dir in die Wohnung zieht."}, {"s": 139.6, "e": 140.5, "text": "Fünf Sekunden."}, {"s": 141.06, "e": 141.88, "text": "Der Nachmieter."}, {"s": 142.26, "e": 143.5, "text": "Mehrzahl, die Nachmieter."}, {"s": 144.28, "e": 146.24, "text": "Hast du es gesagt, bevor du gelesen hast?"}, {"s": 146.52, "e": 147.44, "text": "Dann zählt es."}, {"s": 147.72, "e": 150.3, "text": "Und was passiert mit den Wörtern, die du nicht weißt?"}, {"s": 150.48, "e": 152.26, "text": "Die kommen in die Notaufnahme."}, {"s": 152.44, "e": 154.8, "text": "Eine Box, eine Seite im Heft, egal."}, {"s": 155.16, "e": 158.42, "text": "Jedes Wort, das du auf der Leiter nicht findest, kommt da rein."}, {"s": 158.56, "e": 161.14, "text": "Und am nächsten Morgen wird es zuerst behandelt."}, {"s": 161.48, "e": 163.12, "text": "Neues Bild, neuer Satz."}, {"s": 163.26, "e": 165.92, "text": "Das alte Bild hat ja offensichtlich nicht funktioniert."}, {"s": 166.72, "e": 168.06, "text": "Überhaupt, der Morgen."}, {"s": 168.43, "e": 171.45, "text": "Bevor du neue Wörter lernst, machst du den Morgen-Check."}, {"s": 171.85, "e": 174.39, "text": "5 Minuten, die 50 Wörter von gestern."}, {"s": 174.59, "e": 176.63, "text": "Das ist schon deine erste Wiederholung."}, {"s": 177.03, "e": 181.75, "text": "Danach wiederholst du jedes Paket an Tag 4, 7, 14 und 30."}, {"s": 182.21, "e": 186.48, "text": "Die Abstände werden immer größer, weil das Wort immer fester sitzt."}, {"s": 186.9, "e": 190.02, "text": "So, jetzt der Teil, den viele Videos weglassen."}, {"s": 190.39, "e": 191.45, "text": "Rechnen wir ehrlich."}, {"s": 191.71, "e": 193.97, "text": "Jeden Tag 50 neue Wörter."}, {"s": 193.97, "e": 198.73, "text": "Nach einer Woche kommen jeden Tag die Wiederholungen von drei früheren Tagen dazu."}, {"s": 199.11, "e": 200.49, "text": "150 Karten."}, {"s": 200.84, "e": 202.44, "text": "Nach vier Wochen 200."}, {"s": 202.98, "e": 207.54, "text": "Bei fünf Sekunden pro Karte plus Notaufnahme rund 20 Minuten."}, {"s": 207.92, "e": 208.44, "text": "Extra."}, {"s": 208.86, "e": 209.66, "text": "Jeden Tag."}, {"s": 210.14, "e": 213.06, "text": "Deshalb ist 50 am Tag kein Dauerzustand."}, {"s": 213.22, "e": 214.36, "text": "Es ist ein Sprint."}, {"s": 214.76, "e": 215.3, "text": "Vier Wochen."}, {"s": 215.52, "e": 218.0, "text": "Danach schaltest du in den Erhaltungsmodus."}, {"s": 218.18, "e": 219.92, "text": "20 neue Wörter am Tag."}, {"s": 220.06, "e": 221.96, "text": "Und die Wiederholungen laufen weiter."}, {"s": 222.16, "e": 223.42, "text": "Und noch ehrlicher."}, {"s": 223.42, "e": 229.5, "text": "Die Sieben-Tage-Regel. Ein Wort zählt erst als gelernt, wenn du es am siebten Tag ohne Hilfe"}, {"s": 229.5, "e": 236.34, "text": "sagen kannst. Nicht erkennen, sagen. Von 50 Wörtern schaffen das realistisch 35 bis 40."}, {"s": 236.78, "e": 244.43, "text": "Klingt nach Verlust? Rechne mal. Sechs Lerntage pro Woche. Vier Wochen. Jeden Tag 35 bis 40 Wörter."}, {"s": 244.71, "e": 252.63, "text": "Das sind 840 bis 960 Wörter im Monat. Wörter, die du wirklich kannst. Nicht gesehen. Gekonnt."}, {"s": 252.63, "e": 256.25, "text": "Warum sechs Lerntage? Weil der Sonntag anders ist."}, {"s": 256.47, "e": 259.85, "text": "Am Sonntag gibt es keine neuen Wörter. Nur Wiederholung."}, {"s": 259.99, "e": 264.03, "text": "Und ein kurzer Text mit den Wörtern der Woche. Den liest du laut vor."}, {"s": 264.25, "e": 268.37, "text": "Mein Sonntagstext. Die Besichtigung war super. Die Kaltmiete auch."}, {"s": 268.57, "e": 271.83, "text": "Aber an meiner Kaution kaut die Vermieterin immer noch."}, {"s": 272.67, "e": 276.47, "text": "Gelernt. Und jetzt der Test, den ich dir am Anfang versprochen habe."}, {"s": 276.69, "e": 281.59, "text": "Ich sage die Bedeutung, du sagst das Wort. Laut. Mit Artikel. Bereit?"}]}
